{
  "$defs": {
    "AbortRequest": {
      "additionalProperties": false,
      "description": "abort：中止 attempt（30s 独立死线的 abort 探针由 #16 实现）。",
      "properties": {
        "attempt_id": {
          "type": "string"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "attempt_id"
      ],
      "title": "AbortRequest",
      "type": "object"
    },
    "AdminPluginListResponse": {
      "additionalProperties": false,
      "description": "`GET /admin/plugins` 的响应信封（占位）。",
      "properties": {
        "plugins": {
          "items": {
            "$ref": "#/$defs/PluginSummary"
          },
          "type": "array"
        }
      },
      "required": [
        "plugins"
      ],
      "title": "AdminPluginListResponse",
      "type": "object"
    },
    "AdminStatusResponse": {
      "additionalProperties": false,
      "description": "宿主管理 API 自描述（面板据此知道管理面在跑、契约版本是什么）。",
      "properties": {
        "bind_addr": {
          "description": "宿主监听地址（管理面与契约面同进程同端口，只是前缀不同）。",
          "type": "string"
        },
        "contract_version": {
          "type": "string"
        },
        "host_version": {
          "type": "string"
        },
        "services": {
          "items": {
            "$ref": "#/$defs/ServiceName"
          },
          "type": "array"
        }
      },
      "required": [
        "host_version",
        "contract_version",
        "bind_addr",
        "services"
      ],
      "title": "AdminStatusResponse",
      "type": "object"
    },
    "AttemptState": {
      "description": "attempt 状态（占位闭集；第四终态 `interrupted` 见 GLOSSARY）。",
      "oneOf": [
        {
          "enum": [
            "running",
            "failed",
            "aborted"
          ],
          "type": "string"
        },
        {
          "const": "settled",
          "description": "判据阶梯判终态（`agent_settled` + `stopReason === \"stop\"` 双条件）。",
          "type": "string"
        },
        {
          "const": "interrupted",
          "description": "宿主重启导致的第四终态：非成功非失败，worktree 不清。",
          "type": "string"
        }
      ],
      "title": "AttemptState"
    },
    "AuthScheme": {
      "additionalProperties": false,
      "description": "鉴权方式自描述：编排器据此知道往哪个 header 塞 token。",
      "properties": {
        "admin_header": {
          "description": "宿主管理 API 的**独立** token header（与管理 token 机制区分）。",
          "type": "string"
        },
        "also_accepts_bearer": {
          "description": "同时接受 `Authorization: Bearer <token>`。",
          "type": "boolean"
        },
        "http_header": {
          "description": "契约面（含 `/handshake`、五服务路由与 WS upgrade）的 token header。",
          "type": "string"
        },
        "ws_upgrade_requires_token": {
          "description": "WS upgrade 同样验 token（与 HTTP 同一闭集错误）。",
          "type": "boolean"
        }
      },
      "required": [
        "http_header",
        "also_accepts_bearer",
        "ws_upgrade_requires_token",
        "admin_header"
      ],
      "title": "AuthScheme",
      "type": "object"
    },
    "ClaimRequest": {
      "additionalProperties": false,
      "description": "原子 claim 请求（CAS 语义；失败即已被他人抢走）。",
      "properties": {
        "assignee": {
          "type": "string"
        },
        "issue_id": {
          "type": "string"
        }
      },
      "required": [
        "issue_id",
        "assignee"
      ],
      "title": "ClaimRequest",
      "type": "object"
    },
    "ClaimResponse": {
      "additionalProperties": false,
      "description": "原子 claim 结果。\n\n`claimed` 是**成功投影**：抢到（含同一 assignee 的幂等重claim）恒为 `true`。\n未抢到的调用方收到的是闭集 `conflict` 错误信封（409），`details.holder`\n是当前持有者——GLOSSARY：失败即已被他人抢走。",
      "properties": {
        "claimed": {
          "description": "true = claim 成功；false = 已被他人持有（调用方收到 `conflict` 语义）。",
          "type": "boolean"
        },
        "holder": {
          "type": [
            "string",
            "null"
          ]
        },
        "issue_id": {
          "type": "string"
        }
      },
      "required": [
        "issue_id",
        "claimed"
      ],
      "title": "ClaimResponse",
      "type": "object"
    },
    "ClientInfo": {
      "additionalProperties": false,
      "description": "客户端自描述。",
      "properties": {
        "kind": {
          "$ref": "#/$defs/ClientKind"
        },
        "name": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "version",
        "kind"
      ],
      "title": "ClientInfo",
      "type": "object"
    },
    "ClientKind": {
      "description": "客户端身份种类（闭集）。",
      "oneOf": [
        {
          "const": "orchestrator",
          "description": "编排器：以插件身份接入的独立进程（ADR-0001）。",
          "type": "string"
        },
        {
          "const": "panel",
          "description": "面板：操作台，与编排器同路调用契约。",
          "type": "string"
        },
        {
          "const": "plugin",
          "description": "其他进程级插件。",
          "type": "string"
        }
      ],
      "title": "ClientKind"
    },
    "ContractError": {
      "additionalProperties": false,
      "description": "契约错误信封：HTTP 响应体与 WS 文本帧共用同一形状。\n\n```json\n{\"code\":\"not_implemented\",\"message\":\"...\",\"retryable\":false}\n```",
      "properties": {
        "code": {
          "$ref": "#/$defs/ErrorCode"
        },
        "details": {
          "description": "可选的附加信息（开放形状）；闭集只在 `code` 上。"
        },
        "message": {
          "type": "string"
        },
        "retryable": {
          "default": false,
          "description": "是否可重试；与 `code.is_retryable()` 一致。",
          "type": "boolean"
        }
      },
      "required": [
        "code",
        "message"
      ],
      "title": "ContractError",
      "type": "object"
    },
    "DispatchRequest": {
      "additionalProperties": false,
      "description": "派发请求。",
      "properties": {
        "issue_id": {
          "type": "string"
        },
        "profile": {
          "description": "派内容物（skill / extension / runtime_pins）装配标识。",
          "type": [
            "string",
            "null"
          ]
        },
        "prompt": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "issue_id"
      ],
      "title": "DispatchRequest",
      "type": "object"
    },
    "DispatchResponse": {
      "additionalProperties": false,
      "description": "派发结果。",
      "properties": {
        "attempt_id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/AttemptState"
        }
      },
      "required": [
        "attempt_id",
        "state"
      ],
      "title": "DispatchResponse",
      "type": "object"
    },
    "ErrorCode": {
      "description": "契约错误码闭集。\n\n字符串形式即编排器看到的 `code` 字段（snake_case）。`ALL` 是唯一权威清单，\n一致性套件与生成文档都以它为准。",
      "oneOf": [
        {
          "const": "unauthorized",
          "description": "无 token 或 token 错误。缺 token 与错 token **同码**（不做区分，避免预言机）。",
          "type": "string"
        },
        {
          "const": "forbidden",
          "description": "已鉴权但无权限（例如把操作 token 当管理 token 用）。",
          "type": "string"
        },
        {
          "const": "contract_version_unsupported",
          "description": "握手时契约版本不被宿主支持。",
          "type": "string"
        },
        {
          "const": "invalid_request",
          "description": "请求体/参数不符合契约 schema。",
          "type": "string"
        },
        {
          "const": "not_found",
          "description": "路由不存在。",
          "type": "string"
        },
        {
          "const": "method_not_allowed",
          "description": "路由存在但方法不对。",
          "type": "string"
        },
        {
          "const": "conflict",
          "description": "状态冲突（例如原子 claim 已被他人抢走）。",
          "type": "string"
        },
        {
          "const": "not_implemented",
          "description": "路由已占位、服务未实现（本票骨架的统一回答）。",
          "type": "string"
        },
        {
          "const": "service_unavailable",
          "description": "宿主暂时不可用（可重试）。",
          "type": "string"
        },
        {
          "const": "internal",
          "description": "宿主内部错误（不可重试）。",
          "type": "string"
        }
      ],
      "title": "ErrorCode"
    },
    "EventEnvelope": {
      "additionalProperties": false,
      "description": "事件信封：总线上的唯一形状，WS 文本帧与事件历史查询共用。",
      "properties": {
        "actor": {
          "type": "string"
        },
        "attempt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "audited": {
          "default": false,
          "description": "ADR-0005 §8：是否已入 Kron 账本（未入账事件启动时批量补账）。",
          "type": "boolean"
        },
        "id": {
          "description": "宿主分配的事件 id（单调/唯一）。",
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/EventKind"
        },
        "occurred_at": {
          "description": "RFC3339 时间戳。",
          "type": "string"
        },
        "payload": {
          "default": null
        },
        "ticket_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "id",
        "kind",
        "occurred_at",
        "actor"
      ],
      "title": "EventEnvelope",
      "type": "object"
    },
    "EventHistoryQuery": {
      "additionalProperties": false,
      "description": "事件历史查询（占位）。",
      "properties": {
        "kind": {
          "anyOf": [
            {
              "$ref": "#/$defs/EventKind"
            },
            {
              "type": "null"
            }
          ]
        },
        "limit": {
          "format": "uint32",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "since": {
          "type": [
            "string",
            "null"
          ]
        },
        "ticket_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "title": "EventHistoryQuery",
      "type": "object"
    },
    "EventHistoryResponse": {
      "additionalProperties": false,
      "description": "事件历史响应（占位）。",
      "properties": {
        "events": {
          "items": {
            "$ref": "#/$defs/EventEnvelope"
          },
          "type": "array"
        },
        "truncated": {
          "default": false,
          "description": "是否因保留窗口被截断（ADR-0005 §10）。",
          "type": "boolean"
        }
      },
      "required": [
        "events"
      ],
      "title": "EventHistoryResponse",
      "type": "object"
    },
    "EventKind": {
      "description": "事件种类闭集。",
      "oneOf": [
        {
          "const": "dispatch",
          "description": "派发：agent-runner 起了 attempt（审计双写关键事件）。",
          "type": "string"
        },
        {
          "const": "attempt_started",
          "description": "attempt 生命周期占位：已启动。",
          "type": "string"
        },
        {
          "const": "agent_settled",
          "description": "attempt 生命周期占位：判据阶梯判终态（`agent_settled`）。",
          "type": "string"
        },
        {
          "const": "attempt_finished",
          "description": "attempt 生命周期占位：已结束（成功/失败/interrupted 之外的收尾）。",
          "type": "string"
        },
        {
          "const": "blocked",
          "description": "一等事件：attempt 卡住，claim 保留，人类经 steer/follow_up 回应。",
          "type": "string"
        },
        {
          "const": "needs_attention",
          "description": "一等事件：需要人类注意（插件隔离、取凭据失败等）。",
          "type": "string"
        },
        {
          "const": "steer",
          "description": "steer：人类/编排器向运行中的 attempt 注入指令。",
          "type": "string"
        },
        {
          "const": "abort",
          "description": "abort：探针/人工中止 attempt。",
          "type": "string"
        },
        {
          "const": "stall_kill",
          "description": "stall 判杀：两口钟超时后的判杀（审计双写关键事件）。",
          "type": "string"
        },
        {
          "const": "merge",
          "description": "merge：merge 服务执行了真正的 merge（审计双写关键事件）。",
          "type": "string"
        },
        {
          "const": "approval",
          "description": "审批：人工闸门放行 merge 提议（审计双写关键事件）。",
          "type": "string"
        },
        {
          "const": "interrupted",
          "description": "中断态：宿主重启时 running attempt 被标记的记账状态（第四终态）。",
          "type": "string"
        },
        {
          "const": "host_restarted",
          "description": "宿主重启（审计双写关键事件；ADR-0005 §4 崩溃恢复）。",
          "type": "string"
        },
        {
          "const": "claim_acquired",
          "description": "原子 claim 成功（CAS 语义）。",
          "type": "string"
        },
        {
          "const": "plugin_quarantined",
          "description": "插件重试耗尽进入隔离（quarantined）。",
          "type": "string"
        },
        {
          "const": "notification_sent",
          "description": "通知通道外发完成（HITL 前半程）。",
          "type": "string"
        }
      ],
      "title": "EventKind"
    },
    "HandshakeRequest": {
      "additionalProperties": false,
      "description": "握手请求。",
      "properties": {
        "client": {
          "$ref": "#/$defs/ClientInfo"
        },
        "contract_version": {
          "description": "客户端实现的契约版本，如 `1.0.0`。",
          "type": "string"
        }
      },
      "required": [
        "contract_version",
        "client"
      ],
      "title": "HandshakeRequest",
      "type": "object"
    },
    "HandshakeResponse": {
      "additionalProperties": false,
      "description": "握手响应。",
      "properties": {
        "auth": {
          "$ref": "#/$defs/AuthScheme"
        },
        "contract_version": {
          "description": "宿主实际使用的契约版本。",
          "type": "string"
        },
        "event_kinds": {
          "description": "事件闭集：编排器据此穷举可订阅的事件种类。",
          "items": {
            "$ref": "#/$defs/EventKind"
          },
          "type": "array"
        },
        "host_version": {
          "type": "string"
        },
        "services": {
          "description": "v1 五服务（ADR-0001）。",
          "items": {
            "$ref": "#/$defs/ServiceName"
          },
          "type": "array"
        },
        "supported_contract_versions": {
          "description": "宿主兼容的契约版本清单（当前只有 `[CONTRACT_VERSION]`）。",
          "items": {
            "type": "string"
          },
          "type": "array"
        }
      },
      "required": [
        "contract_version",
        "supported_contract_versions",
        "host_version",
        "services",
        "event_kinds",
        "auth"
      ],
      "title": "HandshakeResponse",
      "type": "object"
    },
    "IssueListResponse": {
      "additionalProperties": false,
      "description": "`GET /v1/tracker/issues` 的响应信封（占位）。",
      "properties": {
        "issues": {
          "items": {
            "$ref": "#/$defs/IssueView"
          },
          "type": "array"
        }
      },
      "required": [
        "issues"
      ],
      "title": "IssueListResponse",
      "type": "object"
    },
    "IssueState": {
      "description": "Issue 归一化状态（占位闭集，provider 语义关进 adapter 后收敛到这些值）。",
      "oneOf": [
        {
          "enum": [
            "open",
            "in_progress",
            "blocked",
            "done"
          ],
          "type": "string"
        },
        {
          "const": "claimed",
          "description": "已被排他 claim（assignee 即 claim）。",
          "type": "string"
        }
      ],
      "title": "IssueState"
    },
    "IssueView": {
      "additionalProperties": false,
      "description": "归一化后的票视图（面板与编排器读同一个视图——tracker 是总线）。\n\nblocking 边是**原语**（ADR-0001 决策 3）：服务只陈述「谁堵谁」，\ndispatchable / frontier 的计算归编排器。",
      "properties": {
        "assignee": {
          "type": [
            "string",
            "null"
          ]
        },
        "blocked_by": {
          "description": "堵住本票的票（provider 原生依赖的声明方向）。加法字段，老客户端忽略即可。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "blocking": {
          "description": "被本票堵住的票（反向，从全量边集推导）。加法字段。",
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "issue_id": {
          "type": "string"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "state": {
          "$ref": "#/$defs/IssueState"
        },
        "title": {
          "type": "string"
        },
        "updated_at": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "issue_id",
        "title",
        "state"
      ],
      "title": "IssueView",
      "type": "object"
    },
    "MappingListResponse": {
      "additionalProperties": false,
      "description": "`GET /v1/workspace/mappings` 的响应信封（占位）。",
      "properties": {
        "mappings": {
          "items": {
            "$ref": "#/$defs/WorkspaceMapping"
          },
          "type": "array"
        }
      },
      "required": [
        "mappings"
      ],
      "title": "MappingListResponse",
      "type": "object"
    },
    "MergeProposal": {
      "additionalProperties": false,
      "description": "agent 的 merge 提议（提议即全部；执行归宿主）。",
      "properties": {
        "commit": {
          "type": [
            "string",
            "null"
          ]
        },
        "message": {
          "type": [
            "string",
            "null"
          ]
        },
        "ticket_id": {
          "type": "string"
        },
        "worktree_branch": {
          "description": "提议的源 worktree / 分支。",
          "type": "string"
        }
      },
      "required": [
        "ticket_id",
        "worktree_branch"
      ],
      "title": "MergeProposal",
      "type": "object"
    },
    "MergeProposalResponse": {
      "additionalProperties": false,
      "description": "提议受理结果。",
      "properties": {
        "proposal_id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/MergeProposalState"
        }
      },
      "required": [
        "proposal_id",
        "state"
      ],
      "title": "MergeProposalResponse",
      "type": "object"
    },
    "MergeProposalState": {
      "description": "merge 提议状态（占位闭集）。",
      "oneOf": [
        {
          "enum": [
            "proposed",
            "merged",
            "rejected"
          ],
          "type": "string"
        },
        {
          "const": "validated",
          "description": "机械闸门通过（worktree 干净、FF 可行、测试过）。",
          "type": "string"
        }
      ],
      "title": "MergeProposalState"
    },
    "NewEvent": {
      "additionalProperties": false,
      "description": "待发布事件：id / occurred_at / audited 由宿主的事件总线盖章。",
      "properties": {
        "actor": {
          "description": "事件产生方（host / agent-runner / orchestrator / human / plugin…）。",
          "type": "string"
        },
        "attempt_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "kind": {
          "$ref": "#/$defs/EventKind"
        },
        "payload": {
          "default": null,
          "description": "开放形状载荷；闭集只在 `kind` 上。"
        },
        "ticket_id": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "kind",
        "actor"
      ],
      "title": "NewEvent",
      "type": "object"
    },
    "PluginState": {
      "description": "插件状态（占位闭集；`quarantined` 见 GLOSSARY「隔离」）。",
      "oneOf": [
        {
          "enum": [
            "running",
            "stopped"
          ],
          "type": "string"
        },
        {
          "const": "quarantined",
